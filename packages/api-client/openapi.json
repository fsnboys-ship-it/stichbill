    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "owner_csrf",
        "tags": [
          "Owner access"
        ],
        "responses": {
          "200": {
            "description": "Sets CSRF cookie and returns csrf for the request header",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrf"
                  ],
