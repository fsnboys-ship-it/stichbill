    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "owner_csrf",
        "tags": [
          "Owner access"
        ],
        "responses": {
          "200": {
            "description": "Sets CSRF cookie and returns csrf for the request header",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "csrf"
                  ],
                  "properties": {
                    "csrf": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "owner_session",
        "tags": [
          "Owner access"
        ],
        "responses": {
          "200": {
            "description": "Only active business memberships from the authenticated server session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "businesses"
                  ],
                  "properties": {
                    "businesses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired session"
          }
        }
      }
    },
