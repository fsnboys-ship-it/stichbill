# LOCAL DEVELOPMENT ONLY. Copy or use npm run setup:env.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Set a local-only password; setup:env generates one and URL-encodes it.
POSTGRES_USER=stichbill_dev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=stichbill_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stichbill_dev:replace-with-local-password@127.0.0.1:5432/stichbill_dev
# Optional isolated test database URL. Tests require a local stichbill_dev or stichbill_test DB.
# TEST_DATABASE_URL=postgresql://stichbill_dev:your-local-password@127.0.0.1:5432/stichbill_test
# No migration execution is authorised in Task 002.
ALLOW_MIGRATIONS=false
