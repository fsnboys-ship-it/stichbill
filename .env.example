# LOCAL BOOTSTRAP ONLY. Use npm run setup:env, then setup:db-env BEFORE starting API.
# setup:db-env moves admin/Compose credentials into ignored .env.db and replaces
# DATABASE_URL with a generated restricted runtime login. Native Windows users
# first set DATABASE_URL to their local administrator URL; see docs/WINDOWS_SETUP.md.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Set a local-only password; setup:env generates one and URL-encodes it.
POSTGRES_USER=stichbill_dev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=stichbill_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stichbill_dev:replace-with-local-password@127.0.0.1:5432/stichbill_dev
# db:test:setup creates separate ignored .env.test and .env.test.db files.
# Explicit db:migrate:local enables gates for reviewed local Task 003 schema only.
ALLOW_MIGRATIONS=false
